  .brandFooter { display: block; position: relative; z-index: 1; color: #bbd3c6; font-size: 11px; }
  .watermark { display: block; position: absolute; right: -230px; top: 8%; width: 640px; height: 640px; opacity: .035; pointer-events: none; }
  .formPanel { display: flex; flex-direction: column; justify-content: center; padding: 40px 24px; }
  .formCard { flex: none; margin: auto; }
  .systemFooter { margin-top: 32px; }
  .mobileCopyright { display: none; }
  .previewArea { position: relative; margin: 40px 4px 0 0; }
  .previewGlow { position: absolute; inset: -50px -24px; background: radial-gradient(ellipse, #9fe6b926, transparent 68%); pointer-events: none; }
  .backCard { position: absolute; inset: 8px -5px -8px 8px; border-radius: 20px; border: 1px solid #ffffff30; background: #ffffff14; transform: rotate(2deg); }
  .preview { position: relative; padding: 24px; border: 1px solid #ffffffc0; border-radius: 16px; background: #fbfdfc; box-shadow: 0 4px 8px #041e1620, 0 24px 48px -16px #041e1680; }
