<file path="src/shared/queue-insights.ts">
import { PRStatus } from '@prisma/client';

export interface QueueTiming {
  status: string;
  createdAt: string;
  auditLogs?: { createdAt: string; previousState: string | null; newState: string }[];
}
export interface QueueFilterRecord {
  createdAt?: string;
  department?: string;
  status?: string;
}
export interface QueueFilters {
  from: string;
  to: string;
  department: string;
  status: string;
}
export const emptyQueueFilters: QueueFilters = { from: '', to: '', department: '', status: '' };

// Dates in CPATS are interpreted in the institution's Philippine time zone.
export function submittedDay(value?: string): string {
  if (!value || !Number.isFinite(Date.parse(value))) return '';
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(value));
  return ['year', 'month', 'day'].map(type => parts.find(part => part.type === type)?.value).join('-');
}
export function matchesQueueFilters(record: QueueFilterRecord, filters: QueueFilters): boolean {
  if (filters.from && filters.to && filters.from > filters.to) return false;
  const day = submittedDay(record.createdAt);
  return (!filters.department || record.department === filters.department) &&
    (!filters.status || record.status === filters.status) &&
    (!filters.from || !!day && day >= filters.from) &&
    (!filters.to || !!day && day <= filters.to);
}
export function currentStageSince(record: QueueTiming): string | undefined {
  if (record.status === PRStatus.Draft || record.status === PRStatus.Declined || record.status === PRStatus.Received_and_Closed) return undefined;
  const entry = record.auditLogs?.filter(event => event.newState === record.status && event.previousState !== event.newState && Number.isFinite(Date.parse(event.createdAt)))
    .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))[0];
  // Legacy first-review requests can use their original submission time.
  return entry?.createdAt || (record.status === PRStatus.Pending_Business_Approval && Number.isFinite(Date.parse(record.createdAt)) ? record.createdAt : undefined);
}
export function waitingTimeLabel(record: QueueTiming, now: number): string {
  if (record.status === PRStatus.Received_and_Closed || record.status === PRStatus.Declined) return 'No active waiting time';
  if (record.status === PRStatus.Draft) return 'Draft · not submitted';
  const since = currentStageSince(record);
  if (!since) return 'Stage start not recorded';
  const days = Math.floor(Math.max(0, now - Date.parse(since)) / 86_400_000);
  return `In current stage: ${days === 0 ? 'less than 1 day' : `${days} day${days === 1 ? '' : 's'}`}`;
}
</file>

<file path="src/shared/submission-feedback.ts">
export type SubmissionIssue = {
  reference?: string;
  kind: 'validation' | 'conflict' | 'rejected' | 'uncertain' | 'saved';
  title: string;
  message: string;
  guidance: string;
};

export class SubmissionResponseError extends Error {
  constructor(public readonly status: number, message: string) {
    super(message);
    this.name = 'SubmissionResponseError';
  }
}

export function describeSubmissionIssue(cause: unknown, committed = false): SubmissionIssue {
  if (committed) return {
    kind: 'saved', title: 'Saved; workspace needs updating',
    message: 'Your action was recorded, but the latest workspace could not be displayed.',
    guidance: 'Refresh or open the existing tracking/history view. Do not submit the same action again.',
  };
  const message = cause instanceof Error ? cause.message : 'The submission response could not be read.';
  if (cause instanceof SubmissionResponseError) {
    if (cause.status === 422) return { kind: 'validation', title: 'Check the highlighted fields', message, guidance: 'Your entries remain in this form. Correct the indicated fields before submitting again.' };
    if (cause.status === 409 || /INVALID OPERATION STATE|currently in .* status|INVALID_LIFECYCLE_STAGE|must possess an .* status|no longer available/i.test(message)) {
      return { kind: 'conflict', title: 'Review the latest record', message, guidance: 'Keep any notes you need, then refresh the workspace and reopen the record. Check its current status before trying again.' };
    }
    if (cause.status >= 400 && cause.status < 500) return { kind: 'rejected', title: 'Submission was not accepted', message, guidance: 'Your entries remain in this form. Resolve the reported issue before trying again.' };
  }
  return { kind: 'uncertain', title: 'Submission result is unconfirmed', message, guidance: 'Your entries remain in this form. Check tracking or history for a saved result before trying again; the server may have received your action.' };
}
