.requester-portal-header > div > div { min-height: 5rem; }
.requester-portal-header img { width: 3rem; height: 3rem; padding: .25rem; border-radius: 50%; background: white; }
.requester-portal-identity > span:last-child { color: #cce0d4; margin-top: .125rem; }
.requester-portal-institution { display: inline-block; margin-left: .75rem; color: #e5ce7f; font-size: .625rem; letter-spacing: .12em; vertical-align: middle; }
.requester-portal-welcome { display: none; color: #cce0d4; font-size: .8125rem; }
