<file path="src/proxy.ts">
// src/proxy.ts
import { NextRequest, NextResponse } from 'next/server';
import { verifySessionToken, SESSION_COOKIE_NAME } from '@/shared/session';
import { ROUTE_ROLE_MAP, isRoleAllowed } from '@/shared/rbac';
import { prisma } from '@/shared/prisma';

const PUBLIC_PATHS = ['/login', '/api/auth/login', '/favicon.ico', '/_next'];
const PUBLIC_ACCOUNT_PATHS = ['/activate', '/reset-password', '/api/auth/request-reset', '/api/auth/complete-token'];

async function currentSessionUser(request: NextRequest) {
  const sessionCookie = request.cookies.get(SESSION_COOKIE_NAME)?.value;
  const claims = sessionCookie ? await verifySessionToken(sessionCookie) : null;
  if (!claims) return null;
  const stored = await prisma.user.findUnique({
    where: { id: claims.id },
    include: { department: { select: { code: true, name: true } } },
  });
  if (!stored || stored.accountStatus !== 'Active' || stored.sessionVersion !== (claims.sessionVersion ?? 0)) return null;
  return {
    id: stored.id,
    email: stored.email,
    role: stored.role,
    departmentId: stored.departmentId,
    departmentCode: stored.department.code,
    departmentName: stored.department.name,
    sessionVersion: stored.sessionVersion,
  };
}

export async function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl;

  if (PUBLIC_PATHS.some((path) => pathname.startsWith(path)) || PUBLIC_ACCOUNT_PATHS.includes(pathname)) {
    if (pathname === '/login') {
      const user = await currentSessionUser(request);
      if (user) {
        return NextResponse.redirect(new URL('/dashboard', request.url));
      }
    }
    return NextResponse.next();
  }

  const user = await currentSessionUser(request);

  if (pathname.startsWith('/uploads/')) {
    if (!user) return NextResponse.json({ success: false, error: 'Sign in to view this attachment.' }, { status: 401 });
    const evidenceUrl = request.nextUrl.clone();
    evidenceUrl.pathname = `/api/evidence/${pathname.slice('/uploads/'.length)}`;
    const evidenceHeaders = new Headers(request.headers);
    evidenceHeaders.set('x-user-id', user.id);
    evidenceHeaders.set('x-user-email', user.email);
    evidenceHeaders.set('x-user-role', user.role);
    evidenceHeaders.set('x-user-department-id', user.departmentId);
    evidenceHeaders.set('x-user-department-code', user.departmentCode);
    evidenceHeaders.set('x-user-session-version', String(user.sessionVersion ?? 0));
    return NextResponse.rewrite(evidenceUrl, { request: { headers: evidenceHeaders } });
  }

  if (pathname.startsWith('/dashboard')) {
    if (!user) {
      const loginUrl = new URL('/login', request.url);
      loginUrl.searchParams.set('callbackUrl', pathname);
      return NextResponse.redirect(loginUrl);
    }

    // Page-Level RBAC Access Control
    const requiredRoles = ROUTE_ROLE_MAP[pathname];
    if (requiredRoles && !isRoleAllowed(user.role, requiredRoles)) {
      return NextResponse.redirect(new URL('/dashboard?error=unauthorized_role', request.url));
    }
  }

  if (pathname.startsWith('/api') && !pathname.startsWith('/api/auth/login')) {
    if (!user) {
      return NextResponse.json(
        { success: false, error: "UNAUTHORIZED: Valid session required." },
        { status: 401 }
      );
    }
  }

  const requestHeaders = new Headers(request.headers);
  if (user) {
    requestHeaders.set('x-user-id', user.id);
    requestHeaders.set('x-user-email', user.email);
    requestHeaders.set('x-user-role', user.role);
    requestHeaders.set('x-user-department-id', user.departmentId);
    requestHeaders.set('x-user-department-code', user.departmentCode);
    requestHeaders.set('x-user-session-version', String(user.sessionVersion ?? 0));
  }

  return NextResponse.next({
    request: {
      headers: requestHeaders,
    },
  });
}

export const config = {
  matcher: ['/dashboard/:path*', '/api/:path*', '/uploads/:path*', '/login'],
};
</file>

<file path="src/shared/account-delivery.ts">
import { createHash, randomBytes } from 'node:crypto';
import { AccountTokenPurpose } from '@prisma/client';
import { prisma } from '@/shared/prisma';
import { sendEmail } from '@/shared/email';

export type AccountDeliveryMode = 'log' | 'smtp';

export function accountDeliveryMode(): AccountDeliveryMode {
  const configured = process.env.CPATS_ACCOUNT_DELIVERY_MODE;
  if (configured === 'log' && process.env.NODE_ENV !== 'production') return 'log';
  if (configured === 'smtp' && process.env.EMAIL_DELIVERY_MODE === 'smtp') return 'smtp';
  if (!configured && process.env.NODE_ENV !== 'production') return 'log';
  throw new Error('Account message delivery is not configured.');
}

export function accountBaseUrl(): string {
  const configured = process.env.APP_BASE_URL;
  if (configured) return new URL(configured).origin;
  if (process.env.NODE_ENV !== 'production') return 'http://localhost:3000';
  throw new Error('APP_BASE_URL is required for account messages.');
}

export function newAccountToken(): { value: string; hash: string } {
  const value = randomBytes(32).toString('base64url');
  return { value, hash: hashAccountToken(value) };
}

export function hashAccountToken(value: string): string {
  return createHash('sha256').update(value).digest('hex');
}

export async function issueAccountToken(userId: string, purpose: AccountTokenPurpose, mode: AccountDeliveryMode): Promise<string> {
  const token = newAccountToken();
  const now = new Date();
  await prisma.$transaction(async (tx) => {
    await tx.accountToken.updateMany({
      where: { userId, purpose, usedAt: null },
      data: { usedAt: now },
    });
    await tx.accountToken.create({ data: {
      userId,
      purpose,
      tokenHash: token.hash,
      deliveredViaSmtp: mode === 'smtp',
      expiresAt: new Date(now.getTime() + (purpose === AccountTokenPurpose.Activation ? 24 * 60 : 30) * 60_000),
    } });
  });
  return token.value;
}

export async function deliverAccountLink(email: string, purpose: AccountTokenPurpose, token: string, mode: AccountDeliveryMode): Promise<void> {
  const path = purpose === AccountTokenPurpose.Activation ? '/activate' : '/reset-password';
  const url = `${accountBaseUrl()}${path}?token=${encodeURIComponent(token)}`;
  const subject = purpose === AccountTokenPurpose.Activation ? '[CPATS] Activate your staff account' : '[CPATS] Reset your password';
  const text = purpose === AccountTokenPurpose.Activation
    ? `An account has been prepared for you in CPATS. Open this one-time link within 24 hours to set your password:\n\n${url}\n\nIf you were not expecting this, contact your institution's IT office.`
    : `A CPATS password reset was requested. Open this one-time link within 30 minutes:\n\n${url}\n\nIf you did not request it, ignore this message and contact your institution's IT office.`;
  if (mode === 'log') {
    console.info('[CPATS ACCOUNT MESSAGE - DEVELOPMENT]', { to: email, subject, text });
    return;
  }
  await sendEmail({ to: email, subject, text });
}
</file>

