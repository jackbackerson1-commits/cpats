  .brandContent { padding: 24px 0; }
  .headline { font-size: clamp(32px, 3vw, 44px); }
  .supporting { margin-top: 16px; line-height: 1.6; }
  .previewArea { margin-top: 24px; }
  .preview { padding: 20px; }
  .recordTitle { margin-top: 12px; }
  .timeline { margin-top: 16px; }
  .timelineStep { padding-bottom: 16px; }
  .formPanel { padding-top: 24px; padding-bottom: 24px; }
  .formCard { padding: 24px 32px; }
  .formCard > div:first-child { margin-bottom: 16px; }
  .formCard form { margin-top: 24px; }
  .formCard form > :not(:last-child) { margin-bottom: 16px; }
  .formCard > p:last-of-type { margin-top: 16px; }
  .formCard > div:last-child { margin-top: 16px; padding-top: 8px; }
  .systemFooter { margin-top: 16px; }
}

@media (prefers-reduced-motion: no-preference) {
  .brandHeader, .brandContent, .formCard { animation: arrive 440ms both; }
  .brandContent { animation-delay: 70ms; }
  .formCard { animation-delay: 140ms; }
  .current span { animation: pulse 2.4s ease-in-out infinite; }
  .spinner { animation: spin 900ms linear infinite; }
  .submit:hover:not(:disabled) { transform: translateY(-1px); }
  .submit:active:not(:disabled) { transform: translateY(1px); }
}
@media (prefers-reduced-motion: reduce) {
  .submit { transition: none; }
  .submit:active:not(:disabled) { transform: none; }
}
@keyframes arrive { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 50% { box-shadow: 0 0 0 5px #24764d18; } }
@keyframes spin { to { transform: rotate(360deg); } }
</file>

