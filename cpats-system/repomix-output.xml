const make = (id: string, status = 'Approved_Awaiting_PO', since?: string) => ({
  id, status, createdAt: '2026-09-01T00:00:00Z', updatedAt: '2026-10-16T00:00:00Z',
  auditLogs: since ? [{ previousState: null, newState: status, createdAt: since }] : [],
