  .statusChip { border: 1px solid #c5e5d3; border-radius: 999px; background: #eaf6ee; padding: 4px 8px; color: #226044; font-weight: 500; letter-spacing: 0; text-transform: none; }
  .recordTitle { margin-top: 16px; color: #172d23; font-size: 14px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
  .recordTitle span { font-weight: 500; }
  .timeline { margin-top: 24px; }
  .timelineStep { display: flex; position: relative; align-items: flex-start; gap: 12px; padding-bottom: 24px; }
  .timelineStep:last-child { padding-bottom: 0; }
  .timelineStep:not(:last-child)::before { content: ''; position: absolute; left: 10px; top: 24px; bottom: 4px; width: 1px; background: #dce7df; }
  .stepIcon { display: grid; position: relative; flex-shrink: 0; place-items: center; width: 22px; height: 22px; border-radius: 50%; }
  .complete { background: #d9f1e2; color: #16603d; }
  .current { border: 1px solid #9bcbb0; background: #edf8f1; }
  .current span { width: 8px; height: 8px; border-radius: 50%; background: #24764d; }
  .pending { border: 1px solid #acbcb2; background: #fff; }
}

@media (min-width: 1024px) {
  .page { padding: 16px; }
  .shell { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); min-height: calc(100svh - 32px); max-width: 1840px; margin: auto; overflow: hidden; border: 1px solid #e0e7e2; border-radius: 24px; }
  .brand { padding: 40px clamp(32px, 4.4vw, 80px); }
  .formPanel { padding: 48px 32px 32px; }
  .formCard { max-width: 500px; padding: 40px; }
  .previewArea { max-width: 440px; }
}

/* Fit laptop browser viewports, including display scaling and browser chrome.
   Keep natural page growth for short windows, zoom, and sign-in errors. */
@media (min-width: 1024px) and (max-height: 900px) {
  .page { padding: 12px; }
  .shell { min-height: calc(100svh - 24px); }
