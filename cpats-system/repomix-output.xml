.submit { transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease; }
.submit:hover:not(:disabled) { background: #092d21; box-shadow: 0 6px 14px -8px #0f3d2e80; }
.submit:active:not(:disabled) { transform: translateY(1px); box-shadow: none; }
.formCard input:autofill,
.formCard input:-webkit-autofill {
  -webkit-text-fill-color: #0f172a;
  -webkit-box-shadow: 0 0 0 1000px #fff inset;
  background-color: #fff;
