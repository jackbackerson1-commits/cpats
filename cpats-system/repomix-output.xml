<file path="src/validation/request-draft.schema.ts">
import { z } from 'zod';

export const REQUEST_ITEM_CATEGORIES = [
  'Monitors & Displays',
  'Cables & Connectors (HDMI, VGA, LAN)',
  'Desktop Computers & Laptops',
  'Peripherals (Mouse, Keyboard, Webcam)',
  'Printers, Scanners & Consumables',
  'Networking Equipment (Switches, Routers)',
  'Office Supplies & Stationery',
  'Other / Custom Item',
] as const;

// Structural limits for unfinished forms; final submission still uses CreatePRSchema.
export const RequestDraftPayloadSchema = z.object({
  items: z.array(z.object({
    category: z.string().max(200).refine((value) => REQUEST_ITEM_CATEGORIES.some((category) => category === value), 'Choose a supported item category.'),
    specs: z.string().max(20000),
    quantity: z.number().nonnegative().max(2147483647),
  })).min(1).max(200),
  justification: z.string().max(50000),
  isDirectPoBypass: z.boolean(),
  adminProofFilePath: z.string().max(2000),
  attachedFileName: z.string().max(1000).nullable(),
  attachedFileSize: z.number().int().nonnegative().nullable(),
  attachedFileIsImage: z.boolean(),
});

export type RequestDraftPayload = z.infer<typeof RequestDraftPayloadSchema>;
export const DraftIdSchema = z.string().uuid();
export const SaveRequestDraftSchema = z.object({ payload: RequestDraftPayloadSchema });
export const RemoveRequestDraftSchema = z.object({
  id: DraftIdSchema,
  version: z.number().int().positive(),
});
export const UpdateRequestDraftSchema = SaveRequestDraftSchema.extend({
  id: DraftIdSchema,
  version: z.number().int().positive(),
});
export const SubmitRequestDraftSchema = z.object({
  draftId: DraftIdSchema,
  draftVersion: z.number().int().positive(),
});
</file>

<file path="src/validation/request-template.schema.ts">
import { z } from 'zod';
import { RequestDraftPayloadSchema, type RequestDraftPayload } from './request-draft.schema';

export const RequestTemplatePayloadSchema = z.object({
  items: RequestDraftPayloadSchema.shape.items.refine(items => items.every(item => item.specs.trim().length > 0 && Number.isInteger(item.quantity) && item.quantity > 0), 'Give each template item specifications and a positive whole quantity.'),
  justification: RequestDraftPayloadSchema.shape.justification,
}).strict();
export type RequestTemplatePayload = z.infer<typeof RequestTemplatePayloadSchema>;
export const SaveRequestTemplateSchema = z.object({
  name: z.string().trim().min(1).max(120),
  payload: RequestTemplatePayloadSchema,
}).strict();
export const RemoveRequestTemplateSchema = z.object({ id: z.string().uuid(), version: z.number().int().positive() }).strict();

export function templateToNewDraft(payload: RequestTemplatePayload): RequestDraftPayload {
  return {
    items: payload.items.map(item => ({ ...item })), justification: payload.justification,
    isDirectPoBypass: false, adminProofFilePath: '', attachedFileName: null,
    attachedFileSize: null, attachedFileIsImage: false,
  };
}
