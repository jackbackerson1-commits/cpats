.requester-workspace :is(button, a, input, select, textarea, summary) { transition-duration: 150ms; }
.requester-workspace :is(input, select, textarea):focus { border-color: var(--request-emerald); }
.requester-workspace [data-request-status] { border-radius: .75rem; padding: .5rem .625rem; font-weight: 600; }
